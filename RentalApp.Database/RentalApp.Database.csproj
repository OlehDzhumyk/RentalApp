<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <!-- Security best practice -->
        <NuGetAudit>true</NuGetAudit>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
        <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.12" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.12" />

        <!-- PostGIS Integration -->
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL.NetTopologySuite" Version="10.0.3" />

        <!-- Security -->
        <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
        <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.12" />
    </ItemGroup>

    <ItemGroup>
        <!-- Embedded so the mobile app can read it; RENTALAPP_CONNECTION overrides it -->
        <EmbeddedResource Include="appsettings.json" />
    </ItemGroup>
</Project>