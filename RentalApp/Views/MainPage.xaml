<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RentalApp.ViewModels"
             x:Class="RentalApp.Views.MainPage"
             x:DataType="vm:MainViewModel"
             Title="{Binding Title}">

    <!--
        Main Application Dashboard
        Central navigation hub for user interaction, notifications, and core services.
    -->

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Profile" 
                     Command="{Binding NavigateToProfileCommand}"
                     IconImageSource="user.png" />
        <ToolbarItem Text="Settings" 
                     Command="{Binding NavigateToSettingsCommand}"
                     IconImageSource="settings.png" />
        <ToolbarItem Text="Logout" 
                     Command="{Binding LogoutCommand}"
                     IconImageSource="logout.png" />
    </ContentPage.ToolbarItems>

    <RefreshView IsRefreshing="{Binding IsBusy}" 
                 Command="{Binding RefreshDataCommand}">
        <ScrollView>
            <Grid Padding="20" RowSpacing="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <!-- Welcome -->
                    <RowDefinition Height="Auto" />
                    <!-- Error Feedback -->
                    <RowDefinition Height="Auto" />
                    <!-- Section Header -->
                    <RowDefinition Height="*"    />
                    <!-- Content Cards -->
                </Grid.RowDefinitions>

                <!-- User Welcome Header -->
                <Border Grid.Row="0"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                        Padding="20"
                        HeightRequest="120">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <VerticalStackLayout VerticalOptions="Center">
                        <Label Text="{Binding WelcomeMessage}"
                               FontSize="24"
                               FontAttributes="Bold"
                               TextColor="White"
                               HorizontalOptions="Center" />
                        <Label Text="{Binding CurrentUser.Email}"
                               FontSize="14"
                               TextColor="White"
                               Opacity="0.8"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- Notification and Error Display -->
                <Border Grid.Row="1"
                        BackgroundColor="{AppThemeBinding Light=#FFEBEE, Dark=#1B0000}"
                        Stroke="{AppThemeBinding Light=#F44336, Dark=#EF5350}"
                        StrokeThickness="1"
                        Padding="15"
                        IsVisible="{Binding HasError}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Grid.Column="0"
                               Text="{Binding ErrorMessage}"
                               TextColor="{AppThemeBinding Light=#D32F2F, Dark=#EF5350}"
                               FontSize="14"
                               VerticalOptions="Center" />

                        <Button Grid.Column="1"
                                Text="×"
                                Command="{Binding ClearErrorCommand}"
                                BackgroundColor="Transparent"
                                TextColor="{AppThemeBinding Light=#D32F2F, Dark=#EF5350}"
                                FontSize="18"
                                Padding="5"
                                WidthRequest="30"
                                HeightRequest="30" />
                    </Grid>
                </Border>

                <Label Grid.Row="2"
                       Text="Quick Actions"
                       FontSize="20"
                       FontAttributes="Bold"
                       Margin="0,10,0,10" />

                <!-- Navigation Hub Cards -->
                <VerticalStackLayout Grid.Row="3" Spacing="15">

                    <!-- Spatial Proximity Search -->
                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"
                            Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                            StrokeThickness="1"
                            Padding="20"
                            HeightRequest="80">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateToNearbyItemsCommand}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Label Grid.Column="0" Text="📍" FontSize="24" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" Margin="15,0,0,0" VerticalOptions="Center">
                                <Label Text="Items Near Me" FontSize="16" FontAttributes="Bold" />
                                <Label Text="Find tools and gear within 5km" FontSize="12" 
                                       TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text=">" FontSize="18" VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray600}}" />
                        </Grid>
                    </Border>

                    <!-- Global Assets Catalog -->
                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"
                            Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                            StrokeThickness="1"
                            Padding="20"
                            HeightRequest="80">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateToItemsCommand}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Label Grid.Column="0" Text="🛠️" FontSize="24" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" Margin="15,0,0,0" VerticalOptions="Center">
                                <Label Text="Browse All Items" FontSize="16" FontAttributes="Bold" />
                                <Label Text="Rent tools, gear, and more" FontSize="12"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text=">" FontSize="18" VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray600}}" />
                        </Grid>
                    </Border>

                    <!-- User Identity Management -->
                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"
                            Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                            StrokeThickness="1"
                            Padding="20"
                            HeightRequest="80">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateToProfileCommand}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Label Grid.Column="0" Text="👤" FontSize="24" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" Margin="15,0,0,0" VerticalOptions="Center">
                                <Label Text="Profile Settings" FontSize="16" FontAttributes="Bold" />
                                <Label Text="Manage your account information" FontSize="12"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text=">" FontSize="18" VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray600}}" />
                        </Grid>
                    </Border>

                    <!-- Administrative Panel (Conditional Visibility) -->
                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"
                            Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                            StrokeThickness="1"
                            Padding="20"
                            HeightRequest="80"
                            IsVisible="{Binding IsAdmin}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateToUserListCommand}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Label Grid.Column="0" Text="🔐" FontSize="24" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" Margin="15,0,0,0" VerticalOptions="Center">
                                <Label Text="User Management" FontSize="16" FontAttributes="Bold" />
                                <Label Text="Manage users and their roles" FontSize="12"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text=">" FontSize="18" VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray600}}" />
                        </Grid>
                    </Border>

                </VerticalStackLayout>
            </Grid>
        </ScrollView>
    </RefreshView>
</ContentPage>
