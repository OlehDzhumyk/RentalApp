<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RentalApp.ViewModels"
             xmlns:models="clr-namespace:RentalApp.Database.Models;assembly=RentalApp.Database"
             x:Class="RentalApp.Views.NearbyItemsPage"
             x:DataType="vm:NearbyItemsViewModel"
             Title="{Binding Title}">

    <!--
        Nearby Items Discovery
        Visualizes rental assets filtered by spatial proximity (PostGIS ST_DWithin)
    -->

    <RefreshView Command="{Binding LoadNearbyItemsCommand}"
                 IsRefreshing="{Binding IsBusy}">

        <CollectionView ItemsSource="{Binding NearbyItems}">

            <!-- Spatial Search Empty State -->
            <CollectionView.EmptyView>
                <VerticalStackLayout VerticalOptions="Center"
                                     HorizontalOptions="Center"
                                     Spacing="10">
                    <Label Text="No items found within the search radius"
                           HorizontalOptions="Center" />
                    <Button Text="Try Again"
                            Command="{Binding LoadNearbyItemsCommand}" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <!-- Proximity-Based Item Template -->
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:NearbyItem">
                    <Border Margin="10,5"
                            Padding="15"
                            Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                            StrokeThickness="1">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>

                        <Grid ColumnDefinitions="*, Auto">
                            <VerticalStackLayout Grid.Column="0"
                                                 Spacing="2">
                                <Label Text="{Binding Item.Title}"
                                       FontSize="18"
                                       FontAttributes="Bold" />

                                <!-- Distance comes from PostGIS (ST_Distance on geography) -->
                                <Label Text="{Binding DistanceKm, StringFormat='{0:F1} km away'}"
                                       TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                            </VerticalStackLayout>

                            <Label Grid.Column="1"
                                   Text="{Binding Item.PricePerDay, StringFormat='£{0:F2}/day'}"
                                   VerticalOptions="Center"
                                   FontAttributes="Bold" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>
    </RefreshView>
</ContentPage>
