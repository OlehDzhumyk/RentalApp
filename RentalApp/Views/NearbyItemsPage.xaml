<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RentalApp.ViewModels"
             x:Class="RentalApp.Views.NearbyItemsPage"
             Title="{Binding Title}">

    <RefreshView Command="{Binding LoadNearbyItemsCommand}" IsRefreshing="{Binding IsBusy}">
        <CollectionView ItemsSource="{Binding NearbyItems}">
            <CollectionView.EmptyView>
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="10">
                    <Label Text="No items found within 10km" HorizontalOptions="Center" />
                    <Button Text="Try Again" Command="{Binding LoadNearbyItemsCommand}" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:ItemDisplayWrapper">
                    <Frame Margin="10,5" Padding="15">
                        <Grid ColumnDefinitions="*, Auto">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="{Binding Item.Title}" FontSize="18" FontAttributes="Bold" />
                                <Label Text="{Binding FormattedDistance}" TextColor="{StaticResource Primary}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1" 
                                   Text="{Binding Item.PricePerDay, StringFormat='£{0}/day'}" 
                                   VerticalOptions="Center" 
                                   FontAttributes="Bold" />
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </RefreshView>
</ContentPage>